<% const beanNo = Number.isInteger(i) ? i + 1 : '' %>
<fieldset class="card" aria-labelledby="bean-legend-<%= i %>" data-bean-row<%= spare ? ' data-bean-spare' : '' %>>
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <legend class="h6 mb-0 w-auto" id="bean-legend-<%= i %>">원두 <span data-bean-number><%= beanNo %></span></legend>
      <button class="btn btn-sm btn-outline-danger" type="button" aria-label="원두 <%= beanNo %> 삭제" data-remove-bean disabled>삭제</button>
    </div>
    <div class="row g-3">
      <% beanFields.forEach((field) => { %>
        <%- include('field', { field, value: row[field.name] ?? '', error: spare ? undefined : errors[`beans.${i}.${field.name}`], inputName: beanInputKey(field.name), inputId: `f-bean-${i}-${field.name}`, boolAsSelect: true, optionalBlank: spare }) %>
      <% }) %>
    </div>
  </div>
</fieldset>
